{
  "name": "birdiebuddy",
  "version": "1.0.0",
  "private": true,
  "description": "골프존 AI 해커톤 — Supabase CSR backend",
  "scripts": {
    "local:start": "node scripts/prepare-local-env.mjs --start",
    "local:env": "node scripts/prepare-local-env.mjs",
    "demo:setup": "node --env-file=.env.backend.local scripts/setup-demo-accounts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && deno check --config deno.json supabase/functions/*/index.ts",
    "test:backend": "tsx --test tests/backend/*.test.ts && deno test --config deno.json supabase/functions/",
    "verify:backend": "node --import tsx --env-file=.env.backend.local scripts/verify-backend.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "test": "npm run test:backend"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "supabase": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
