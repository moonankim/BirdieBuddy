{
  "name": "birdiebuddy",
  "version": "1.0.0",
  "private": true,
  "description": "골프존 AI 해커톤 — Next.js 화면 + Supabase CSR backend",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib/session tests/ui",
    "typecheck:ui": "tsc --noEmit -p tsconfig.json",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "local:start": "node scripts/prepare-local-env.mjs --start",
    "local:env": "node scripts/prepare-local-env.mjs",
    "demo:setup": "node --env-file=.env.backend.local scripts/setup-demo-accounts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.backend.json && deno check --config deno.json supabase/functions/*/index.ts",
    "test:backend": "tsx --test tests/backend/*.test.ts && deno test --config deno.json supabase/functions/",
    "verify:backend": "node --import tsx --env-file=.env.backend.local scripts/verify-backend.mjs",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "test": "npm run test:backend"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "27.4.0",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
