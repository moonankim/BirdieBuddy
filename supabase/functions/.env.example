# The local environment script writes the platform-provided local keys to .env.
# Never put hosted Supabase keys or provider credentials in this example file.
BB_LOCAL_PUBLISHABLE_KEY=sb_publishable_replace_me
BB_LOCAL_SECRET_KEY=sb_secret_replace_me
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The local environment script opts into sample AI only on the local Supabase network.
BB_USE_LOCAL_AI_FIXTURE=false
ANTHROPIC_API_KEY=replace_me
TYPESAFE_API_KEY=replace_me
